# =============================================================================
# KRUN RAG Chatbot — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Anthropic API (REQUIRED) -------------------------------------------------
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Zero Data Retention -----------------------------------------------------
# Set to "true" once your Anthropic console enrollment is approved.
# When true, the client adds the `anthropic-zero-retention-window: 0` header.
# Default false until enrollment confirmed.
ZDR_ENABLED=false

# --- Models (override config.yaml if set) ------------------------------------
# CLAUDE_GEN_MODEL=claude-sonnet-4-6
# CLAUDE_ANALYZER_MODEL=claude-haiku-4-5-20251001

# --- Vault path (override config.yaml if set) --------------------------------
# Windows example:
# VAULT_PATH=C:\Users\anton\Documents\Obsidian_KRUN_Antonio
# WSL example:
# VAULT_PATH=/mnt/c/Users/anton/Documents/Obsidian_KRUN_Antonio

# --- Storage ------------------------------------------------------------------
# Where LanceDB writes its `.lance` directories
LANCEDB_PATH=./data/lancedb

# --- Embedding model cache ---------------------------------------------------
# Hugging Face will cache BGE-M3 here (about 2.3 GB on first download)
HF_HOME=./.cache/huggingface

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
